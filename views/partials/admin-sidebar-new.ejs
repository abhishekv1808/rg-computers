  <!-- Bottom User / Logout -->
  <div class="p-4 border-t border-gray-50">
    <form action="/admin/logout" method="POST" class="mt-4" id="logoutForm">
      <button
        type="button"
        onclick="openLogoutModal()"
        class="flex items-center gap-3 px-4 py-2 text-gray-500 hover:text-red-500 transition-colors w-full font-medium"
      >
        <i class="fas fa-sign-out-alt"></i>
        <span>Sign Out</span>
      </button>
