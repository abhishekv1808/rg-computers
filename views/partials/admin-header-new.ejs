                <!-- Top Header -->
                <header class="h-20 bg-white/80 backdrop-blur-md border-b border-gray-100 flex items-center justify-between px-8 z-10">
                    <h2 class="text-2xl font-bold text-gray-800">Dashboard</h2>
                    
                    <!-- Search & Actions -->
                    <div class="flex items-center gap-6">
                        <form action="/admin/inventory" method="GET" class="relative hidden md:block group">
                            <input type="text" 
                                   name="search" 
                                   placeholder="Search products..." 
                                   value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                                   class="pl-12 pr-4 py-3 bg-gray-50/50 border border-gray-100 rounded-2xl text-sm focus:ring-4 focus:ring-primary/10 focus:border-primary/20 focus:bg-white transition-all w-96 text-gray-700 placeholder-gray-400 font-medium shadow-sm group-hover:shadow-md group-hover:bg-white">
                            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-hover:text-primary transition-colors text-lg"></i>
                        </form>
                        
                        <div class="flex items-center gap-4">
                            <div class="flex items-center gap-2 text-sm font-medium text-gray-600 cursor-pointer hover:text-gray-900">
                                <img src="https://flagcdn.com/w20/us.png" class="rounded-sm" alt="US">
                                <span>Eng (US)</span>
                                <i class="fas fa-chevron-down text-xs ml-1"></i>
                            </div>
                            
                            <button class="w-10 h-10 bg-yellow-50 text-yellow-500 rounded-xl flex items-center justify-center hover:bg-yellow-100 transition-colors relative">
                                <i class="fas fa-bell"></i>
                                <span class="absolute top-2 right-2.5 w-2 h-2 bg-red-500 rounded-full border border-white"></span>
                            </button>

                            <div class="flex items-center gap-3 pl-4 border-l border-gray-100">
                                <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="Admin" class="w-10 h-10 rounded-xl object-cover shadow-sm">
                                <div class="hidden md:block text-left leading-tight">
                                    <p class="text-sm font-bold text-gray-900">Musfiq</p>
                                    <p class="text-[10px] text-gray-400 font-medium">Admin</p>
                                </div>
                                <i class="fas fa-chevron-down text-gray-400 text-xs ml-1 cursor-pointer"></i>
                            </div>
                        </div>
                    </div>
                </header>
