<%- include('../partials/head.ejs') %>

    <body class="bg-[#F3F4F6] font-[Urbanist] text-gray-700">

        <div class="flex h-screen overflow-hidden">
            <!-- Sidebar -->
            <%- include('../partials/admin-sidebar-new.ejs') %>

            <!-- Main Content Wrapper -->
            <div class="flex-1 flex flex-col h-screen overflow-hidden relative">
                
                <!-- Top Header -->
                <%- include('../partials/admin-header-new.ejs') %>

                <!-- Scrollable Main -->
                <main class="flex-1 overflow-x-hidden overflow-y-auto bg-[#FAFBFD] p-6 md:p-8">
                    
                    <div class="max-w-5xl mx-auto">
                        <!-- Breadcrumb & Title -->
                        <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                            <div>
                                <a href="/admin/inventory" class="text-xs font-bold text-gray-400 hover:text-blue-800 mb-2 inline-flex items-center transition-colors uppercase tracking-wider">
                                    <i class="fas fa-arrow-left mr-2"></i> Back to Inventory
                                </a>
                                <h1 class="text-3xl font-bold text-gray-900 tracking-tight">
                                    <%= editing ? 'Edit Product' : 'Add New Product' %>
                                </h1>
                                <p class="text-gray-500 mt-1 text-sm">Fill in the details below to <%= editing ? 'update the product' : 'add a new product' %>.</p>
                            </div>
                            <% if (editing) { %>
                                <div class="px-4 py-2 bg-blue-50 text-blue-900 rounded-lg text-xs font-bold border border-blue-100 uppercase tracking-wide">
                                    SKU: <span class="font-mono ml-1"><%= laptop._id %></span>
                                </div>
                            <% } %>
                        </div>

                        <form action="/admin/<%= editing ? 'edit-laptop' : 'add-laptop' %>" method="POST" enctype="multipart/form-data" class="space-y-8 pb-12">
                            
                            <!-- Main Info Card -->
                            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                                <div class="p-6 border-b border-gray-50 flex items-center gap-4">
                                    <div class="h-10 w-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-800">
                                        <i class="fas fa-box-open"></i>
                                    </div>
                                    <h3 class="text-lg font-bold text-gray-900">Basic Information</h3>
                                </div>

                                <div class="p-8 space-y-8">
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                                        <div class="group">
                                            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide" for="brand">Brand</label>
                                            <div class="relative">
                                                <select class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all bg-white appearance-none cursor-pointer hover:border-blue-300" id="brand" name="brand" required>
                                                    <option value="" disabled <%=!editing ? 'selected' : '' %>>Select Brand</option>
                                                    <% const brands=['Dell', 'HP' , 'Lenovo' , 'Apple' , 'Acer' ]; %>
                                                    <% brands.forEach(brand=> { %>
                                                        <option value="<%= brand %>" <%=editing && laptop.brand===brand ? 'selected' : '' %>><%= brand %></option>
                                                    <% }) %>
                                                </select>
                                                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-gray-400">
                                                    <i class="fas fa-chevron-down text-xs"></i>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="group">
                                            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide" for="category">Category</label>
                                            <div class="relative">
                                                <select class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all bg-white appearance-none cursor-pointer hover:border-blue-300" id="category" name="category" required>
                                                    <option value="" disabled <%=!editing ? 'selected' : '' %>>Select Category</option>
                                                    <% const categories=['Standard', 'Corporate' , 'Workstation' , 'Gaming', 'Monitor' ]; %>
                                                    <% categories.forEach(cat=> { %>
                                                        <option value="<%= cat %>" <%=editing && laptop.category===cat ? 'selected' : '' %>><%= cat %></option>
                                                    <% }) %>
                                                </select>
                                                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-gray-400">
                                                    <i class="fas fa-chevron-down text-xs"></i>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="group">
                                            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide" for="model">Model Name</label>
                                            <input class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all placeholder-gray-400" id="model" type="text" name="model" value="<%= editing ? laptop.model : '' %>" placeholder="e.g. XPS 15 9520" required>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                                        <div class="group">
                                            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide" for="mrp">MRP</label>
                                            <div class="relative">
                                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                                    <span class="text-gray-400 font-medium">&#8377;</span>
                                                </div>
                                                <input class="w-full pl-8 pr-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all font-medium text-gray-900" id="mrp" type="number" step="0.01" name="mrp" value="<%= editing ? laptop.mrp : '' %>" placeholder="0.00" required>
                                            </div>
                                        </div>
                                        <div class="group">
                                            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide" for="price">Our Price</label>
                                            <div class="relative">
                                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                                    <span class="text-gray-400 font-medium">&#8377;</span>
                                                </div>
                                                <input class="w-full pl-8 pr-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all font-bold text-gray-900" id="price" type="number" step="0.01" name="price" value="<%= editing ? laptop.price : '' %>" placeholder="0.00" required>
                                            </div>
                                        </div>
                                        
                                        <div class="col-span-full">
                                            <label class="block text-xs font-bold text-gray-700 mb-3 uppercase tracking-wide" for="images">Product Gallery</label>
                                            
                                            <!-- Enhanced File Upload Zone -->
                                            <div class="mb-6">
                                                <label id="drop-zone" class="group flex flex-col items-center justify-center w-full h-48 px-6 transition-all bg-gray-50 border-2 border-gray-300 border-dashed rounded-2xl cursor-pointer hover:bg-blue-50/50 hover:border-blue-800 hover:scale-[1.005]">
                                                    <div class="flex flex-col items-center justify-center pt-5 pb-6 text-center pointer-events-none">
                                                        <div class="w-16 h-16 mb-4 rounded-full bg-blue-50 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                                                            <i class="fas fa-cloud-upload-alt text-3xl text-blue-800"></i>
                                                        </div>
                                                        <p class="mb-2 text-sm text-gray-600">
                                                            <span class="font-bold text-blue-800 hover:underline">Click to upload</span> or drag and drop
                                                        </p>
                                                        <p class="text-xs text-gray-400">SVG, PNG, JPG or WEBP (MAX. 10 files)</p>
                                                    </div>
                                                    <input type="file" name="images" id="file-input" class="hidden" multiple accept="image/*" onchange="previewImages(event)">
                                                </label>
                                            </div>

                                            <div id="new-images-preview" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 mb-6 empty:hidden"></div>

                                            <% if (editing) { let existingUrls=[]; if (laptop.imageUrls && laptop.imageUrls.length> 0) { existingUrls = laptop.imageUrls; } else if (laptop.imageUrl) { existingUrls = [laptop.imageUrl]; } %>
                                            <% if (existingUrls.length> 0) { %>
                                                <div class="space-y-3">
                                                    <div class="flex items-center justify-between border-b border-gray-100 pb-2">
                                                        <label class="text-xs font-bold text-gray-400 uppercase tracking-wider">Current Gallery</label>
                                                        <span class="text-xs text-gray-400"><%= existingUrls.length %> images</span>
                                                    </div>
                                                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4" id="existing-images-container">
                                                        <% existingUrls.forEach((url, index)=> { %>
                                                            <div class="relative group aspect-[4/3] bg-white rounded-xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-md transition-all">
                                                                <img src="<%= url %>" class="w-full h-full object-contain p-2 transition-transform duration-500 group-hover:scale-105">
                                                                <input type="hidden" name="existingImages" value="<%= url %>">
                                                                <div class="absolute inset-x-0 bottom-0 p-2 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex justify-end">
                                                                    <button type="button" onclick="this.closest('.relative').remove()" class="bg-red-500 hover:bg-red-600 text-white p-2 rounded-lg shadow-sm transition-colors" title="Remove Image">
                                                                        <i class="fas fa-trash-alt text-xs"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        <% }) %>
                                                    </div>
                                                </div>
                                            <% } %>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="group">
                                        <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide" for="description">Product Description</label>
                                        <textarea class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all leading-relaxed placeholder-gray-400 shadow-sm" id="description" name="description" rows="5" placeholder="Write a detailed description..." required><%= editing ? laptop.description : '' %></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Inventory Details Card -->
                            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                                <div class="p-6 border-b border-gray-50 flex items-center gap-4">
                                    <div class="h-10 w-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-800">
                                        <i class="fas fa-boxes"></i>
                                    </div>
                                    <h3 class="text-lg font-bold text-gray-900">Inventory Status</h3>
                                </div>
                                <div class="p-8">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                        <div class="group">
                                            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide" for="stockQuantity">Stock Quantity</label>
                                            <input class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all font-mono" id="stockQuantity" type="number" name="stockQuantity" value="<%= editing ? laptop.stockQuantity : '0' %>" min="0" required>
                                        </div>
                                        <div class="group">
                                            <label class="block text-xs font-bold text-gray-700 mb-2 uppercase tracking-wide" for="status">Availability Status</label>
                                            <div class="relative">
                                                <select class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all bg-white appearance-none cursor-pointer" id="status" name="status" required>
                                                    <option value="In Stock" <%=editing && laptop.status==='In Stock' ? 'selected' : '' %>>In Stock</option>
                                                    <option value="Low Stock" <%=editing && laptop.status==='Low Stock' ? 'selected' : '' %>>Low Stock</option>
                                                    <option value="Out of Stock" <%=editing && laptop.status==='Out of Stock' ? 'selected' : '' %>>Out of Stock</option>
                                                    <option value="Discontinued" <%=editing && laptop.status==='Discontinued' ? 'selected' : '' %>>Discontinued</option>
                                                </select>
                                                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-gray-400">
                                                    <i class="fas fa-chevron-down text-xs"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Specs Card -->
                             <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                                <div class="p-6 border-b border-gray-50 flex items-center gap-4">
                                    <div class="h-10 w-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-800">
                                        <i class="fas fa-memory"></i>
                                    </div>
                                    <h3 class="text-lg font-bold text-gray-900">Technical Specifications</h3>
                                </div>
                                <div class="p-8">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                                        <!-- Spec Fields (Simplified for brevity but reusing styles) -->
                                        <% const specs = [
                                            {id: 'processor', label: 'Processor', val: editing ? laptop.specifications.processor : ''},
                                            {id: 'ram', label: 'Memory (RAM)', val: editing ? laptop.specifications.ram : ''},
                                            {id: 'storage', label: 'Storage', val: editing ? laptop.specifications.storage : ''},
                                            {id: 'display', label: 'Display', val: editing ? laptop.specifications.display : ''},
                                            {id: 'graphics', label: 'Graphics Card', val: editing ? laptop.specifications.graphics : ''},
                                        ]; %>
                                        <% specs.forEach(spec => { %>
                                        <div class="group">
                                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2 pl-1" for="<%= spec.id %>"><%= spec.label %></label>
                                            <input class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all bg-gray-50 hover:bg-white focus:bg-white" id="<%= spec.id %>" type="text" name="<%= spec.id %>" value="<%= spec.val %>">
                                        </div>
                                        <% }) %>
                                        
                                        <!-- OS Select -->
                                        <div class="group">
                                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2 pl-1" for="os">Operating System</label>
                                            <div class="relative">
                                                <select class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-800 focus:border-transparent transition-all bg-gray-50 hover:bg-white focus:bg-white appearance-none cursor-pointer" id="os" name="os" required>
                                                    <option value="" disabled <%=!editing ? 'selected' : '' %>>Select OS</option>
                                                    <% const osOptions=['Windows 10', 'Windows 10 Pro' , 'Windows 11', 'Windows 11 Pro' , 'Mac OS' ]; %>
                                                    <% osOptions.forEach(os=> { %>
                                                        <option value="<%= os %>" <%=editing && laptop.specifications.os===os ? 'selected' : '' %>><%= os %></option>
                                                    <% }) %>
                                                </select>
                                                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-gray-400">
                                                    <i class="fas fa-chevron-down text-xs"></i>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                            
                            <% if (editing) { %>
                                <input type="hidden" name="laptopId" value="<%= laptop._id %>">
                            <% } %>

                            <div class="flex items-center justify-end gap-3 pt-4">
                                <a href="/admin/inventory" class="px-6 py-3 border border-gray-300 rounded-xl text-sm font-bold text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400 transition-colors uppercase tracking-wide">Cancel</a>
                                <button type="submit" class="px-8 py-3 bg-blue-900 border border-transparent rounded-xl text-sm font-bold text-white hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-900 shadow-lg shadow-blue-200 transition-all flex items-center uppercase tracking-wide">
                                    <i class="fas fa-save mr-2"></i>
                                    <%= editing ? 'Update Product' : 'Create Product' %>
                                </button>
                            </div>

                        </form>
                    </div>
                </main>
            </div>
        </div>

        <script>
            // Setup Drag and Drop
            const dropZone = document.getElementById('drop-zone');
            const fileInput = document.getElementById('file-input');
            let allFiles = new DataTransfer();

            if (dropZone) {
                ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                    dropZone.addEventListener(eventName, preventDefaults, false);
                });

                function preventDefaults(e) { e.preventDefault(); e.stopPropagation(); }

                ['dragenter', 'dragover'].forEach(eventName => {
                    dropZone.addEventListener(eventName, highlight, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropZone.addEventListener(eventName, unhighlight, false);
                });

                function highlight(e) { dropZone.classList.add('border-blue-800', 'bg-blue-50'); }
                function unhighlight(e) { dropZone.classList.remove('border-blue-800', 'bg-blue-50'); }

                dropZone.addEventListener('drop', handleDrop, false);

                function handleDrop(e) {
                    const dt = e.dataTransfer;
                    const files = dt.files;
                    handleFiles(files);
                }
            }

            function handleFiles(files) {
                if (files.length > 0) {
                    // Identify new unique files (deduplication)
                    const uniqueNewFiles = [];
                    Array.from(files).forEach(file => {
                        const exists = Array.from(allFiles.files).some(f => f.name === file.name && f.size === file.size);
                        if (!exists) {
                            uniqueNewFiles.push(file);
                        }
                    });

                    if (uniqueNewFiles.length === 0) return; // All were duplicates

                    // Check if adding these unique files exceeds the limit
                    if (allFiles.files.length + uniqueNewFiles.length > 10) {
                        alert('You can only upload a maximum of 10 images. Please select fewer images.');
                        // Restore the input to the current valid set (essential if this came from an input change)
                        fileInput.files = allFiles.files; 
                        return;
                    }

                    // Add valid unique files
                    uniqueNewFiles.forEach(file => allFiles.items.add(file));
                    fileInput.files = allFiles.files;
                    generatePreview();
                }
            }

            function previewImages(event) {
                const files = event.target.files;
                handleFiles(files);
            }

            function generatePreview() {
                const previewContainer = document.getElementById('new-images-preview');
                previewContainer.innerHTML = '';
                const files = allFiles.files;

                if (files && files.length > 0) {
                     const header = document.createElement('div');
                     header.className = 'col-span-full flex items-center justify-between pb-2 border-b border-gray-100';
                     header.innerHTML = `
                        <label class="text-xs font-bold text-blue-900 uppercase tracking-wider">Ready to Upload</label>
                        <div class="flex items-center gap-2">
                             <span class="text-xs text-blue-800 font-bold">${files.length} new files</span>
                             <button type="button" onclick="clearAllNewFiles()" class="text-[10px] text-red-500 hover:text-red-700 font-bold uppercase">Clear All</button>
                        </div>`;
                     previewContainer.appendChild(header);

                    Array.from(files).forEach((file, index) => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const div = document.createElement('div');
                            div.className = 'relative aspect-[4/3] bg-white rounded-xl overflow-hidden border-2 border-blue-50 shadow-sm group';
                            div.innerHTML = `
                            <img src="${e.target.result}" class="w-full h-full object-contain p-2">
                             <button type="button" onclick="removeNewFile(${index})" class="absolute top-2 left-2 bg-red-500 text-white rounded-full p-1.5 shadow-sm hover:bg-red-600 transition-colors z-10" title="Remove">
                                <i class="fas fa-times text-xs w-3 h-3 flex items-center justify-center"></i>
                            </button>
                        `;
                            previewContainer.appendChild(div);
                        }
                        reader.readAsDataURL(file);
                    });
                }
            }

            function removeNewFile(index) {
                const dt = new DataTransfer();
                const files = allFiles.files;
                for (let i = 0; i < files.length; i++) {
                    if (i !== index) dt.items.add(files[i]);
                }
                allFiles = dt;
                fileInput.files = allFiles.files;
                generatePreview();
            }

            function clearAllNewFiles() {
                allFiles = new DataTransfer();
                fileInput.files = allFiles.files;
                generatePreview();
            }

            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    const mrp = parseFloat(document.getElementById('mrp').value);
                    const price = parseFloat(document.getElementById('price').value);
                    if (price > mrp) {
                        e.preventDefault();
                        alert('Selling Price cannot be greater than MRP.');
                    }
                });
            }
        </script>
    </body>
    </html>