<%- include('../partials/head.ejs') %>
<body class="bg-[#F0F2F5] min-h-screen flex items-center justify-center p-4 lg:p-0">

    <div class="w-full max-w-[1600px] h-[90vh] bg-white rounded-[40px] shadow-2xl overflow-hidden flex flex-col lg:flex-row m-4 lg:m-8 ring-1 ring-gray-100/50">
        
        <!-- Left Side: Visual/Marketing (Primary Theme) -->
        <div class="w-full lg:w-[55%] bg-primary relative flex flex-col items-center justify-center p-12 lg:p-20 overflow-hidden order-2 lg:order-1 group">
            <!-- Background Decorations -->
            <div class="absolute top-0 left-0 w-full h-full bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 mix-blend-soft-light"></div>
            <div class="absolute -top-20 -left-20 w-96 h-96 bg-primary-light rounded-full mix-blend-multiply filter blur-3xl opacity-50 animate-blob"></div>
            <div class="absolute -bottom-20 -right-20 w-96 h-96 bg-primary-dark rounded-full mix-blend-multiply filter blur-3xl opacity-50 animate-blob animation-delay-2000"></div>

            <div class="relative z-10 text-center max-w-2xl">
                <h1 class="text-4xl lg:text-6xl font-extrabold text-white leading-tight mb-8 tracking-tight">
                    Manage Your <br>
                    <span class="text-cyan-300">Empire</span>
                </h1>
                
                <p class="text-white/80 text-lg mb-12 font-medium max-w-md mx-auto leading-relaxed">
                    Overview your inventory, sales, and performance in one powerful dashboard.
                </p>

                <!-- 3D/Glass Card Composition -->
                <div class="relative w-full max-w-md mx-auto h-[400px]">
                     <!-- Main Dashboard Preview Card -->
                    <div class="absolute inset-x-0 top-0 mx-auto w-[85%] h-[70%] bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl shadow-2xl transform transition-transform duration-500 hover:scale-105 hover:-rotate-1 z-20 flex flex-col p-4">
                        <!-- Tiny faux header -->
                        <div class="flex items-center gap-2 mb-4">
                             <div class="w-3 h-3 rounded-full bg-red-400"></div>
                             <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                             <div class="w-3 h-3 rounded-full bg-green-400"></div>
                        </div>
                        <!-- Faux charts -->
                        <div class="flex gap-4 mb-4">
                            <div class="w-1/3 h-24 bg-white/20 rounded-xl"></div>
                            <div class="w-1/3 h-24 bg-white/20 rounded-xl"></div>
                            <div class="w-1/3 h-24 bg-white/20 rounded-xl"></div>
                        </div>
                        <div class="flex-1 bg-white/10 rounded-xl w-full"></div>
                    </div>

                    <!-- Floating Badge 1 -->
                    <div class="absolute top-10 -right-4 bg-white p-4 rounded-2xl shadow-xl z-30 animate-float-slow">
                         <div class="flex items-center gap-3">
                             <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                                 <i class="fas fa-arrow-up"></i>
                             </div>
                             <div>
                                 <p class="text-xs text-gray-500 font-bold uppercase">Sales</p>
                                 <p class="text-lg font-bold text-gray-800">+24%</p>
                             </div>
                         </div>
                    </div>

                    <!-- Floating Badge 2 -->
                    <div class="absolute bottom-20 -left-6 bg-white p-4 rounded-2xl shadow-xl z-30 animate-float-delayed">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                                <i class="fas fa-box"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500 font-bold uppercase">Stock</p>
                                <p class="text-lg font-bold text-gray-800">Updated</p>
                            </div>
                        </div>
                   </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Login Form -->
        <div class="w-full lg:w-[45%] bg-white flex flex-col justify-center items-center p-12 lg:p-24 order-1 lg:order-2">
            <div class="w-full max-w-md">
                <!-- Brand -->
                <div class="mb-12 flex items-center gap-3">
                    <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-primary/30">
                        <i class="fas fa-cube"></i>
                    </div>
                    <span class="text-2xl font-bold text-gray-900 tracking-tight">Dabang Admin</span>
                </div>

                <div class="mb-8">
                    <h2 class="text-3xl font-bold text-gray-900 mb-2">Welcome Back! 👋</h2>
                    <p class="text-gray-500 font-medium">Please enter your details to sign in.</p>
                </div>

                <% if (errorMessage) { %>
                    <div class="p-4 mb-6 text-sm text-red-600 bg-red-50 rounded-xl border border-red-100 flex items-center gap-3 animate-shake">
                         <i class="fas fa-exclamation-circle text-lg"></i>
                        <span class="font-medium"><%= errorMessage %></span>
                    </div>
                <% } %>

                <form action="/admin/login" method="POST" class="space-y-6">
                    <div class="space-y-2">
                        <label for="email" class="block text-xs font-bold text-gray-500 uppercase tracking-wide ml-1">Username / Email</label>
                        <div class="relative">
                            <input type="email" name="email" id="email" required placeholder="name@company.com"
                                class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border-none rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white transition-all text-gray-700 font-medium placeholder-gray-400">
                            <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        </div>
                    </div>

                    <div class="space-y-2">
                         <label for="password" class="block text-xs font-bold text-gray-500 uppercase tracking-wide ml-1">Password</label>
                         <div class="relative">
                            <input type="password" name="password" id="password" required placeholder="••••••••"
                                class="w-full pl-11 pr-12 py-3.5 bg-gray-50 border-none rounded-2xl focus:ring-2 focus:ring-primary/20 focus:bg-white transition-all text-gray-900 text-lg font-medium placeholder-gray-400">
                            <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <button type="button" onclick="togglePassword()" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary transition-colors focus:outline-none">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-1">
                        <label class="flex items-center gap-2 cursor-pointer group select-none">
                            <input type="checkbox" class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary cursor-pointer accent-primary">
                            <span class="text-sm text-gray-500 group-hover:text-gray-700 font-medium transition-colors">Remember me</span>
                        </label>
                        <a href="#" class="text-sm font-bold text-primary hover:text-primary-dark transition-colors">Forgot Password?</a>
                    </div>

                    <button type="submit"
                        class="w-full py-4 bg-primary hover:bg-primary-dark text-white font-bold text-base rounded-2xl shadow-xl shadow-primary/20 hover:shadow-2xl hover:shadow-primary/30 hover:-translate-y-0.5 transition-all duration-300">
                        Sign In
                    </button>
                    
                     <p class="text-center text-sm text-gray-400 mt-8">
                        Need help? <a href="#" class="text-primary font-bold hover:underline">Contact Support</a>
                    </p>
                </form>
            </div>
        </div>
    </div>

    <!-- Animation Styles -->
    <style>
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        .animate-blob {
            animation: blob 7s infinite;
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
        @keyframes float-slow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .animate-float-slow {
            animation: float-slow 4s ease-in-out infinite;
        }
        .animate-float-delayed {
            animation: float-slow 4s ease-in-out 2s infinite;
        }
    </style>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>
