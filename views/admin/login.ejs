<%- include('../partials/head.ejs') %>
<body class="bg-white min-h-screen">
    <div class="w-full min-h-screen flex">
        <!-- Left Side - Form -->
        <div class="w-full lg:w-1/2 flex flex-col justify-center items-center p-8 lg:p-16 bg-white relative z-10">
            <div class="w-full max-w-md space-y-6">
                <div class="text-left mb-8">
                    <a href="/" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-[#5D5FEF] transition-colors mb-6 group">
                        <i class="fas fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
                        Back to Home
                    </a>
                    <h1 class="text-3xl font-bold text-gray-900 mb-2 flex items-center gap-2">
                        Login <span class="text-2xl">✌️</span>
                    </h1>
                    <p class="text-gray-500 text-sm">Welcome back! Please login to your account.</p>
                </div>

                <% if (errorMessage) { %>
                    <div class="p-4 mb-4 text-sm text-red-700 bg-red-50 rounded-xl border border-red-100 flex items-center gap-2" role="alert">
                        <i class="fas fa-exclamation-circle"></i>
                        <span><%= errorMessage %></span>
                    </div>
                <% } %>

                <form action="/admin/login" method="POST" class="space-y-5">
                    <div class="space-y-1.5">
                        <label for="email" class="text-sm font-bold text-gray-700">Email</label>
                        <input type="email" name="email" id="email" required placeholder="admin@rgcomputers.in"
                            class="w-full px-5 py-3.5 rounded-2xl border border-gray-300 focus:border-[#5D5FEF] focus:ring-2 focus:ring-[#5D5FEF]/20 outline-none transition-all text-gray-900 placeholder-gray-400 text-sm">
                    </div>

                    <div class="space-y-1.5">
                        <label for="password" class="text-sm font-bold text-gray-700">Password</label>
                        <input type="password" name="password" id="password" required placeholder="••••••••"
                            class="w-full px-5 py-3.5 rounded-2xl border border-gray-300 focus:border-[#5D5FEF] focus:ring-2 focus:ring-[#5D5FEF]/20 outline-none transition-all text-gray-900 placeholder-gray-400 text-sm">
                    </div>

                    <div class="flex items-center justify-end">
                        <a href="#" class="text-sm font-medium text-[#5D5FEF] hover:text-[#4A4BC8]">Forgot Password?</a>
                    </div>

                    <button type="submit"
                        class="w-full py-4 px-4 bg-[#5D5FEF] hover:bg-[#4A4BC8] text-white font-bold rounded-2xl shadow-lg hover:shadow-xl transition-all transform active:scale-[0.98] text-sm">
                        Login
                    </button>
                </form>

                <p class="text-left text-xs text-gray-400 mt-8">
                    &copy; <%= new Date().getFullYear() %> RG Computers. All rights reserved.
                </p>
            </div>
        </div>

        <!-- Right Side - Banner -->
        <div class="hidden lg:flex w-1/2 bg-[#5D5FEF] relative items-center justify-center overflow-hidden">
            <!-- Background Patterns (Abstract Waves) -->
            <div class="absolute inset-0 opacity-20 pointer-events-none">
                <svg class="absolute top-0 left-0 w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <path d="M0 0 L0 100 L100 100 L100 0 Z" fill="none"/>
                    <path d="M-20 20 Q 30 50 80 20 T 180 20" stroke="white" stroke-width="2" fill="none"/>
                    <path d="M-20 40 Q 30 70 80 40 T 180 40" stroke="white" stroke-width="2" fill="none"/>
                    <path d="M-20 60 Q 30 90 80 60 T 180 60" stroke="white" stroke-width="2" fill="none"/>
                    <path d="M-20 80 Q 30 110 80 80 T 180 80" stroke="white" stroke-width="2" fill="none"/>
                    <path d="M-20 100 Q 30 130 80 100 T 180 100" stroke="white" stroke-width="2" fill="none"/>
                    
                    <!-- Vertical line -->
                    <line x1="20" y1="40" x2="20" y2="60" stroke="white" stroke-width="0.5" opacity="0.5" />
                    <line x1="25" y1="70" x2="30" y2="70" stroke="white" stroke-width="0.5" opacity="0.5" />
                </svg>
            </div>

            <!-- Content Container -->
            <div class="relative z-10 w-full max-w-lg px-8 flex flex-col items-center">
                <div class="bg-white/10 backdrop-blur-md rounded-[40px] p-8 border border-white/10 shadow-2xl w-full relative overflow-hidden">
                    
                     <div class="text-left mb-6 relative z-10">
                        <h2 class="text-3xl font-bold text-white leading-tight">
                            Empowering Your<br>Digital World <span class="text-2xl">🚀</span>
                        </h2>
                        <h3 class="text-2xl font-bold text-white mt-2">RG Computers Admin</h3>
                     </div>
                    
                    <div class="relative flex justify-center mt-4">
                        <!-- Main Image -->
                        <div class="relative z-10 rounded-b-full overflow-hidden">
                             <img src="https://images.unsplash.com/photo-1664575602276-acd073f104c1?auto=format&fit=crop&w=800&q=80" 
                             alt="Admin User" 
                             class="object-cover h-[350px] w-auto mix-blend-normal rounded-xl">
                        </div>

                        <!-- Floating Badges -->
                        <div class="absolute right-0 top-10 bg-white p-3 rounded-full shadow-lg animate-bounce z-20 w-12 h-12 flex items-center justify-center">
                            <span class="text-xl font-bold text-red-500">💯</span>
                        </div>
                        
                        <div class="absolute left-0 bottom-10 bg-white p-3 rounded-full shadow-lg animate-pulse z-20 w-12 h-12 flex items-center justify-center">
                            <span class="text-xl">💻</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>