<%- include('../partials/head.ejs') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <body class="bg-[#F3F4F6] font-[Urbanist] text-gray-700">

        <div class="flex h-screen overflow-hidden">
            <!-- Sidebar -->
            <%- include('../partials/admin-sidebar-new.ejs') %>

            <!-- Main Content Wrapper -->
            <div class="flex-1 flex flex-col h-screen overflow-hidden relative">
                
                <!-- Top Header -->
                <%- include('../partials/admin-header-new.ejs') %>

                <!-- Scrollable Main -->
                <main class="flex-1 overflow-x-hidden overflow-y-auto bg-[#FAFBFD] p-8">
                    
                    <!-- Dashboard Header & Actions -->
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                        <div>
                           <p class="text-gray-500 text-sm">Here is today's report and performances</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <a href="/admin/add-laptop" class="px-4 py-2 bg-red-800 text-white rounded-lg text-sm font-bold hover:bg-red-900 transition-colors flex items-center gap-2 shadow-sm">
                                <i class="fas fa-laptop"></i> Add Laptop
                            </a>
                            <a href="/admin/add-monitor" class="px-4 py-2 bg-red-800 text-white rounded-lg text-sm font-bold hover:bg-red-900 transition-colors flex items-center gap-2 shadow-sm">
                                <i class="fas fa-desktop"></i> Add Monitor
                            </a>
                            <a href="#" class="px-4 py-2 bg-red-800 text-white rounded-lg text-sm font-bold hover:bg-red-900 transition-colors flex items-center gap-2 shadow-sm">
                                <i class="fas fa-hdd"></i> Add Desktop
                            </a>
                        </div>
                    </div>

                    <!-- Stats Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                        
                        <!-- Card 1: Total Inventory -->
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 relative overflow-hidden group">
                            <div class="flex justify-between items-start mb-4">
                                <h3 class="text-gray-500 text-sm font-bold">Total Inventory</h3>
                                <button class="text-gray-300 hover:text-gray-500"><i class="fas fa-ellipsis-h"></i></button>
                            </div>
                            <div class="flex items-baseline gap-2 mb-2">
                                <span class="text-3xl font-bold text-gray-900"><%= totalLaptops %></span>
                                <span class="text-sm text-gray-500">Items</span>
                            </div>
                            <div class="flex items-center gap-1 text-xs font-bold text-emerald-500">
                                <i class="fas fa-arrow-up"></i>
                                <span>+12% from last month</span>
                            </div>
                            <!-- Background decoration -->
                            <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-red-50 rounded-full opacity-50 group-hover:scale-110 transition-transform"></div>
                        </div>

                        <!-- Card 2: Out of Stock -->
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 relative overflow-hidden group">
                            <div class="flex justify-between items-start mb-4">
                                <h3 class="text-gray-500 text-sm font-bold">Out of Stock</h3>
                                <button class="text-gray-300 hover:text-gray-500"><i class="fas fa-ellipsis-h"></i></button>
                            </div>
                            <div class="flex items-baseline gap-2 mb-2">
                                <span class="text-3xl font-bold text-gray-900"><%= outOfStock %></span>
                                <span class="text-sm text-gray-500">Items</span>
                            </div>
                            <div class="flex items-center gap-1 text-xs font-bold text-red-500">
                                <i class="fas fa-arrow-down"></i>
                                <span>Needs Attention</span>
                            </div>
                             <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-red-50 rounded-full opacity-50 group-hover:scale-110 transition-transform"></div>
                        </div>

                        <!-- Card 3: New Enquiries (Mock) -->
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 relative overflow-hidden group">
                            <div class="flex justify-between items-start mb-4">
                                <h3 class="text-gray-500 text-sm font-bold">New Enquiries</h3>
                                <button class="text-gray-300 hover:text-gray-500"><i class="fas fa-ellipsis-h"></i></button>
                            </div>
                            <div class="flex items-baseline gap-2 mb-2">
                                <span class="text-3xl font-bold text-gray-900">1</span>
                                <span class="text-sm text-gray-500">Pending</span>
                            </div>
                            <div class="flex items-center gap-1 text-xs font-bold text-red-500">
                                <i class="fas fa-envelope"></i>
                                <span>Needs Response</span>
                            </div>
                             <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-red-50 rounded-full opacity-50 group-hover:scale-110 transition-transform"></div>
                        </div>

                        <!-- Card 4: Inventory Value -->
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 relative overflow-hidden group">
                            <div class="flex justify-between items-start mb-4">
                                <h3 class="text-gray-500 text-sm font-bold">Inventory Value</h3>
                                <button class="text-gray-300 hover:text-gray-500"><i class="fas fa-ellipsis-h"></i></button>
                            </div>
                            <div class="flex items-baseline gap-2 mb-2">
                                <span class="text-3xl font-bold text-gray-900">₹<%= (totalValue / 1000).toFixed(1) %>L</span>
                            </div>
                            <div class="flex items-center gap-1 text-xs font-bold text-emerald-500">
                                <i class="fas fa-arrow-up"></i>
                                <span>+5% from last quarter</span>
                            </div>
                             <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-red-50 rounded-full opacity-50 group-hover:scale-110 transition-transform"></div>
                        </div>

                    </div>

                    <!-- Charts Section -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                        
                        <!-- Stock Performance (Bar Chart) -->
                        <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-lg font-bold text-gray-900">Stock Performance</h3>
                                <select class="text-xs border-gray-200 rounded-lg text-gray-500 focus:ring-0 cursor-pointer bg-gray-50 border px-2 py-1">
                                    <option>Weekly</option>
                                    <option>Monthly</option>
                                    <option>Yearly</option>
                                </select>
                            </div>
                            <div class="h-64 w-full">
                                <canvas id="stockChart"></canvas>
                            </div>
                        </div>

                        <!-- Category Split (Doughnut Chart) -->
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col">
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="text-lg font-bold text-gray-900">Category Split</h3>
                                <button class="text-gray-300 hover:text-gray-500"><i class="fas fa-calendar"></i></button>
                            </div>
                            <div class="relative flex-1 flex items-center justify-center min-h-[200px]">
                                <canvas id="brandChart"></canvas>
                                <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                                    <span class="text-3xl font-bold text-gray-900" id="totalLaptopsCount">0</span>
                                    <span class="text-xs text-gray-500 font-medium">Total Items</span>
                                </div>
                            </div>
                             <div class="mt-4">
                                <button class="w-full py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-500 hover:bg-gray-50 transition-colors">
                                    View Full Details
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Inventory Table -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="p-6 border-b border-gray-50 flex items-center justify-between">
                            <h3 class="text-lg font-bold text-gray-900">Recent Inventory</h3>
                            <select class="text-xs border-gray-200 rounded-lg text-gray-500 focus:ring-0 cursor-pointer bg-gray-50 border px-2 py-1">
                                <option>All Items</option>
                                <option>In Stock</option>
                                <option>Out of Stock</option>
                            </select>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full whitespace-nowrap text-left">
                                <thead class="bg-gray-50/50">
                                    <tr>
                                        <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">Product</th>
                                        <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">Price</th>
                                        <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">Specs</th>
                                        <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">Status</th>
                                        <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-50">
                                    <% if (laptops.length > 0) { %>
                                        <% laptops.slice(0, 5).forEach(laptop => { %>
                                            <tr class="group hover:bg-gray-50/50 transition-colors">
                                                <td class="px-6 py-4 whitespace-normal min-w-[300px]">
                                                    <div class="flex items-center gap-3">
                                                        <div class="h-10 w-10 rounded-lg bg-gray-100 flex-shrink-0 p-1 border border-gray-200">
                                                            <% const displayImage = (laptop.imageUrls && laptop.imageUrls.length > 0) ? laptop.imageUrls[0] : (laptop.imageUrl || 'https://via.placeholder.com/150'); %>
                                                            <img src="<%= displayImage %>" class="w-full h-full object-contain">
                                                        </div>
                                                        <div>
                                                            <div class="text-sm font-bold text-gray-900"><%= laptop.model %></div>
                                                            <div class="text-xs text-gray-500"><%= laptop.brand %></div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4">
                                                    <span class="text-sm font-bold text-gray-900">&#8377;<%= laptop.price.toLocaleString('en-IN') %></span>
                                                </td>
                                                <td class="px-6 py-4">
                                                    <div class="text-xs text-gray-500">
                                                        <span class="font-medium text-gray-700"><%= laptop.specifications.processor %></span> / <%= laptop.specifications.ram %>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4">
                                                    <% 
                                                    let statusColor = 'text-gray-500 bg-gray-100';
                                                    if (laptop.status === 'In Stock') statusColor = 'text-emerald-600 bg-emerald-50';
                                                    else if (laptop.status === 'Low Stock') statusColor = 'text-amber-600 bg-amber-50';
                                                    else if (laptop.status === 'Out of Stock') statusColor = 'text-red-600 bg-red-50';
                                                    %>
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= statusColor %>">
                                                        <%= laptop.status %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 text-right">
                                                    <a href="/admin/edit-laptop/<%= laptop._id %>?edit=true" class="text-gray-400 hover:text-blue-600 transition-colors">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    // --- Doughnut Chart (Category Split) ---
                    const ctxBrand = document.getElementById('brandChart').getContext('2d');
                    const brandData = <%- JSON.stringify(brandData || { labels: [], data: [] }) %>;
                    const totalItems = brandData.data.reduce((a, b) => a + b, 0);
                    
                    document.getElementById('totalLaptopsCount').textContent = totalItems;

                    const brandColors = [
                        '#B91C1C', // Red 700 (Primary-ish)
                        '#10B981', // Emerald 500
                        '#3B82F6', // Blue 500
                        '#F59E0B', // Amber 500
                        '#6366F1'  // Indigo 500
                    ];

                    if (brandData.labels.length > 0) {
                        new Chart(ctxBrand, {
                            type: 'doughnut',
                            data: {
                                labels: brandData.labels,
                                datasets: [{
                                    data: brandData.data,
                                    backgroundColor: brandColors,
                                    borderWidth: 0,
                                    hoverOffset: 4,
                                    cutout: '85%'
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        backgroundColor: '#fff',
                                        titleColor: '#111',
                                        bodyColor: '#666',
                                        borderColor: '#eee',
                                        borderWidth: 1,
                                        padding: 10,
                                        displayColors: true,
                                        callbacks: {
                                            label: function(context) {
                                                const label = context.label || '';
                                                const value = context.raw || 0;
                                                const percentage = Math.round((value / totalItems) * 100) + '%';
                                                return ` ${label}: ${value} (${percentage})`;
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    }

                    // --- Bar Chart (Stock Performance - Mock Data) ---
                    const ctxStock = document.getElementById('stockChart').getContext('2d');
                    new Chart(ctxStock, {
                        type: 'bar',
                        data: {
                            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                            datasets: [
                                {
                                    label: 'In Stock',
                                    data: [12, 19, 3, 5, 2, 3, 10],
                                    backgroundColor: '#E5E7EB', // Gray 200
                                    borderRadius: 4,
                                    barThickness: 20
                                },
                                {
                                    label: 'Sold',
                                    data: [20, 25, 10, 15, 8, 12, 22],
                                    backgroundColor: '#B91C1C', // Red 700
                                    borderRadius: 4,
                                    barThickness: 20
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    grid: {
                                        color: '#F3F4F6',
                                        drawBorder: false
                                    },
                                    ticks: {
                                        font: { size: 10 },
                                        color: '#9CA3AF'
                                    }
                                },
                                x: {
                                    grid: { display: false },
                                    ticks: {
                                        font: { size: 10 },
                                        color: '#9CA3AF'
                                    }
                                }
                            }
                        }
                    });
                });
            </script>

        </main> <!-- End Main -->
    </div> <!-- End Main Wrapper -->
</div> <!-- End Sidebar Wrapper -->
</body>
</html>