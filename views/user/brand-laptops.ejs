<%- include('../partials/head.ejs') %>

    <body>
        <%- include('../partials/navbar.ejs') %>
            <main class="bg-gray-50 min-h-screen pt-4 pb-12">
                <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- Breadcrumb -->
                    <div class="flex items-center justify-between mb-6">
                        <nav class="flex text-sm text-gray-500">
                            <a href="/" class="hover:text-cyan-600 transition-colors">Home</a>
                            <span class="mx-2">/</span>
                            <a href="/laptops" class="hover:text-cyan-600 transition-colors">Laptops</a>
                            <span class="mx-2">/</span>
                            <span class="text-gray-900 font-bold">
                                <%= brandName %>
                            </span>
                        </nav>
                    </div>

                    <!-- Title -->
                    <div class="mb-8">
                        <h1 class="text-2xl font-bold text-gray-900">
                            <%= brandName %> Laptops
                        </h1>
                        <p class="text-sm text-gray-500 mt-1">Showing all available <%= brandName %> laptops</p>
                    </div>

                    <!-- Product Grid (Full Width) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        <% if (laptops && laptops.length> 0) { %>
                            <% laptops.forEach(laptop=> {
                                const discount = laptop.mrp - laptop.price;
                                const discountPercent = Math.round((discount / laptop.mrp) * 100);
                                %>
                                <a href="/laptop/<%= laptop.slug %>" class="group block h-full bg-white rounded-3xl p-3 shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-300">
                                    <div class="bg-gray-50 rounded-2xl p-6 mb-4 relative overflow-hidden transition-transform duration-500 group-hover:scale-[1.02]">
                                        <!-- Badges -->
                                        <div class="absolute top-4 left-4 z-10 flex flex-col gap-2">
                                            <% if (laptop.stockQuantity === 0) { %>
                                                <span class="bg-red-500 text-white text-[10px] font-bold px-3 py-1.5 rounded-full shadow-sm">
                                                    OUT OF STOCK
                                                </span>
                                            <% } %>
                                            <% if(laptop.stockQuantity < 5 && laptop.stockQuantity > 0) { %>
                                                <span class="bg-red-50 text-red-600 border border-red-100 text-[10px] font-bold px-3 py-1.5 rounded-full shadow-sm">
                                                    <%= laptop.stockQuantity %> Left
                                                </span>
                                            <% } %>
                                        </div>

                                        <!-- Sale Badge -->
                                        <div class="absolute top-4 right-4 z-10">
                                            <span class="bg-cyan-500 text-white text-[10px] font-bold px-3 py-1.5 rounded-full shadow-sm">
                                                <%= discountPercent %>% OFF
                                            </span>
                                        </div>

                                        <!-- Image -->
                                        <div class="aspect-[4/3] flex items-center justify-center">
                                            <img src="<%= laptop.imageUrls[0] %>" 
                                                 alt="<%= laptop.model %>" 
                                                 class="w-full h-full object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-110">
                                        </div>
                                    </div>

                                    <div class="px-2">
                                        <h3 class="font-bold text-gray-900 mb-1 leading-tight group-hover:text-cyan-700 transition-colors line-clamp-2 h-10">
                                            <%= laptop.brand %> <%= laptop.model %>
                                        </h3>
                                        <p class="text-sm text-gray-400 mb-3 truncate">
                                            <%= laptop.specifications.processor %> / <%= laptop.specifications.ram %> / <%= laptop.specifications.storage %>
                                        </p>
                                        
                                        <!-- Rating Section -->
                                                    <div class="flex items-center gap-2 mb-3">
                                                        <span class="bg-[#1e3a8a] text-white text-[10px] font-bold px-2.5 py-1 rounded-md shadow-sm">Top Rated</span>
                                                        <div class="flex items-center gap-1 bg-white border border-gray-200 px-2 py-0.5 rounded-md shadow-sm">
                                                            <span class="text-xs font-bold text-gray-700">4.7</span>
                                                            <i class="fas fa-star text-yellow-400 text-[10px]"></i>
                                                        </div>
                                                    </div>
                                        
                                        <div class="flex items-baseline gap-3">
                                            <span class="text-lg font-bold text-gray-900">₹<%= laptop.price.toLocaleString('en-IN') %></span>
                                            <span class="text-xs text-gray-400 line-through">₹<%= laptop.mrp.toLocaleString('en-IN') %></span>
                                            <span class="text-xs font-bold text-green-600"><%= discountPercent %>% OFF</span>
                                        </div>
                                    </div>
                                </a>
                                <% }) %>
                                    <% } else { %>
                                        <div class="col-span-full text-center py-24">
                                            <div class="flex flex-col items-center justify-center">
                                                <div
                                                    class="h-16 w-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                                                    <i class="fas fa-laptop text-gray-400 text-2xl"></i>
                                                </div>
                                                <h3 class="text-lg font-bold text-gray-900">No laptops found</h3>
                                                <p class="text-gray-500 mt-1">We couldn't find any <%= brandName %>
                                                        laptops in stock mostly.</p>
                                                <a href="/laptops"
                                                    class="mt-4 text-cyan-600 font-bold hover:underline">View all
                                                    laptops</a>
                                            </div>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </main>
            <%- include('../partials/footer.ejs') %>
    </body>
