<%- include('../partials/head.ejs') %>


    <body>

        <%- include('../partials/navbar.ejs') %>

            <main class="bg-gray-50 min-h-screen">

                <!-- HERO SECTION START -->
                <section class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-8">
                    <div class="relative w-full h-[500px] md:h-[600px] rounded-[40px] overflow-hidden shadow-2xl shadow-gray-200/50 group ring-1 ring-black/5">

                        <!-- Carousel Slides Container -->
                        <div id="hero-carousel"
                            class="flex h-full transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] will-change-transform">

                            <!-- SLIDE 1: SELL LAPTOP -->
                            <div class="min-w-full h-full bg-gradient-to-br from-[#0f172a] via-[#1e293b] to-[#0f172a] relative flex items-center overflow-hidden">
                                <!-- Background Decoration -->
                                <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-teal-500/20 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/3 animate-pulse-slow"></div>
                                <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[100px] translate-y-1/3 -translate-x-1/4"></div>
                                
                                <!-- Grid Pattern Overlay -->
                                <div class="absolute inset-0 bg-[url('/images/grid-pattern.svg')] opacity-[0.03]"></div>

                                <div class="w-full h-full max-w-7xl mx-auto px-6 md:px-16 flex items-center justify-between relative z-10">
                                    <!-- Left Content -->
                                    <div class="w-full md:w-1/2 text-white space-y-8 animate-fade-in-up pl-4">
                                        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-teal-500/10 border border-teal-500/20 backdrop-blur-md">
                                            <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
                                            <span class="text-teal-300 text-xs font-bold tracking-wider uppercase">Instant Cash Payment</span>
                                        </div>
                                        
                                        <h1 class="text-5xl md:text-7xl font-bold leading-tight tracking-tight">
                                            Sell Your Old
                                            <br>
                                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400">Laptop Today</span>
                                        </h1>
                                        
                                        <p class="text-lg md:text-xl text-gray-300 font-medium max-w-lg leading-relaxed">
                                            Get the best price for your used device. Free doorstep pickup or visit our 200+ partner stores.
                                        </p>
                                        
                                        <div class="flex flex-col sm:flex-row gap-4 pt-2">
                                            <button class="group relative px-8 py-4 bg-teal-500 hover:bg-teal-400 text-white font-bold rounded-2xl transition-all duration-300 shadow-lg shadow-teal-500/25 hover:shadow-teal-500/40 hover:-translate-y-1 overflow-hidden">
                                                <span class="relative z-10 flex items-center gap-2">
                                                    Sell Now <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                                                </span>
                                            </button>
                                            <button class="px-8 py-4 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold rounded-2xl transition-all duration-300 backdrop-blur-sm flex items-center gap-2">
                                                <i class="fas fa-calculator text-teal-400"></i> Check Value
                                            </button>
                                        </div>
                                        
                                        <!-- Trust Indicators -->
                                        <div class="flex items-center gap-6 pt-4 text-sm font-medium text-gray-400">
                                            <div class="flex items-center gap-2">
                                                <i class="fas fa-check-circle text-teal-500"></i> Instant Payment
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <i class="fas fa-check-circle text-teal-500"></i> Safe & Secure
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Right Image Area -->
                                    <div class="hidden md:flex w-1/2 h-full items-center justify-center relative perspective-1000">
                                        <!-- Main Image -->
                                        <div class="relative z-10 transform transition-transform duration-700 hover:scale-105 hover:rotate-1">
                                            <div class="absolute inset-0 bg-teal-500/20 blur-3xl rounded-full -z-10"></div>
                                            <img src="https://images.unsplash.com/photo-1556742049-0cfed4f7a07d?auto=format&fit=crop&q=80&w=800"
                                                class="h-[450px] object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] mask-image-gradient"
                                                alt="Happy Customer">
                                        </div>

                                        <!-- Floating Cards -->
                                        <div class="absolute top-1/4 left-0 bg-gray-900/80 backdrop-blur-xl border border-white/10 p-4 rounded-2xl shadow-2xl animate-float-slow z-20 max-w-[200px]">
                                            <div class="flex items-center gap-3 mb-2">
                                                <div class="w-10 h-10 rounded-full bg-teal-500/20 flex items-center justify-center text-teal-400">
                                                    <i class="fas fa-truck-fast"></i>
                                                </div>
                                                <div>
                                                    <p class="text-xs text-gray-400 uppercase font-bold">Service</p>
                                                    <p class="text-white font-bold">Free Pickup</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="absolute bottom-1/4 right-10 bg-white/90 backdrop-blur-xl border border-white/20 p-4 rounded-2xl shadow-2xl animate-float-delayed z-20">
                                            <div class="flex items-center gap-3">
                                                <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-600 text-xl font-bold">
                                                    ₹
                                                </div>
                                                <div>
                                                    <p class="text-xs text-gray-500 uppercase font-bold">Payment</p>
                                                    <p class="text-gray-900 font-bold text-lg">Instant Cash</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SLIDE 2: BUY REFURBISHED -->
                            <div class="min-w-full h-full bg-gradient-to-br from-[#4f46e5] via-[#4338ca] to-[#3730a3] relative flex items-center overflow-hidden">
                                <!-- Background Decoration -->
                                <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-indigo-400/20 via-transparent to-transparent"></div>
                                <div class="absolute bottom-0 right-0 w-[700px] h-[700px] bg-purple-500/20 rounded-full blur-[100px] translate-y-1/3 translate-x-1/4"></div>

                                <div class="w-full h-full max-w-7xl mx-auto px-6 md:px-16 flex items-center justify-between relative z-10">
                                    <!-- Left Content -->
                                    <div class="w-full md:w-1/2 text-white space-y-8 pl-4">
                                        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-md">
                                            <span class="text-indigo-200 text-xs font-bold tracking-wider uppercase">Premium Quality</span>
                                        </div>

                                        <h1 class="text-5xl md:text-7xl font-bold leading-tight tracking-tight">
                                            Refurbished
                                            <br>
                                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-200 to-white">Perfection</span>
                                        </h1>
                                        
                                        <p class="text-lg md:text-xl text-indigo-100 font-medium max-w-lg leading-relaxed">
                                            Save up to 60% on premium laptops. Rigorously tested, certified, and backed by a 6-month warranty.
                                        </p>
                                        
                                        <div class="flex flex-col sm:flex-row gap-4 pt-2">
                                            <button class="group px-8 py-4 bg-white text-indigo-600 font-bold rounded-2xl transition-all duration-300 shadow-lg shadow-indigo-900/20 hover:shadow-indigo-900/40 hover:-translate-y-1">
                                                <span class="flex items-center gap-2">
                                                    Shop Now <i class="fas fa-shopping-bag group-hover:scale-110 transition-transform"></i>
                                                </span>
                                            </button>
                                            <button class="px-8 py-4 bg-indigo-500/30 hover:bg-indigo-500/40 border border-indigo-400/30 text-white font-bold rounded-2xl transition-all duration-300 backdrop-blur-sm">
                                                View Warranty
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Right Image Area -->
                                    <div class="hidden md:flex w-1/2 h-full items-center justify-center relative">
                                        <img src="https://images.unsplash.com/photo-1593642702821-c8da6771f0c6?auto=format&fit=crop&q=80&w=800"
                                            class="h-[400px] object-contain drop-shadow-[0_25px_50px_rgba(0,0,0,0.4)] rounded-3xl transform -rotate-6 hover:rotate-0 transition-all duration-700 z-10 border-4 border-white/10"
                                            alt="Refurbished Laptop">
                                            
                                        <!-- Badge -->
                                        <div class="absolute top-1/3 right-10 bg-white text-indigo-900 p-4 rounded-2xl shadow-xl transform rotate-12 animate-float-slow z-20">
                                            <div class="text-center">
                                                <p class="text-3xl font-bold">60%</p>
                                                <p class="text-xs font-bold uppercase tracking-wider">Off MRP</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SLIDE 3: REPAIR EXPERTS -->
                            <div class="min-w-full h-full bg-gradient-to-br from-[#be123c] via-[#9f1239] to-[#881337] relative flex items-center overflow-hidden">
                                <!-- Background Decoration -->
                                <div class="absolute inset-0 bg-[url('/images/circuit-pattern.svg')] opacity-10"></div>
                                <div class="absolute top-1/2 left-1/2 w-[800px] h-[800px] bg-rose-500/20 rounded-full blur-[120px] -translate-x-1/2 -translate-y-1/2"></div>

                                <div class="w-full h-full max-w-7xl mx-auto px-6 md:px-16 flex items-center justify-between relative z-10">
                                    <!-- Left Content -->
                                    <div class="w-full md:w-1/2 text-white space-y-8 pl-4">
                                        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rose-500/20 border border-rose-400/30 backdrop-blur-md">
                                            <i class="fas fa-screwdriver-wrench text-rose-200 text-xs"></i>
                                            <span class="text-rose-100 text-xs font-bold tracking-wider uppercase">Expert Repairs</span>
                                        </div>

                                        <h1 class="text-5xl md:text-7xl font-bold leading-tight tracking-tight">
                                            Broken Laptop?
                                            <br>
                                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-200 to-orange-200">We Fix It.</span>
                                        </h1>
                                        
                                        <p class="text-lg md:text-xl text-rose-100 font-medium max-w-lg leading-relaxed">
                                            Professional chip-level repairs, screen replacements, and upgrades. Same-day delivery for most issues.
                                        </p>
                                        
                                        <div class="flex flex-col sm:flex-row gap-4 pt-2">
                                            <button class="group px-8 py-4 bg-white text-rose-700 font-bold rounded-2xl transition-all duration-300 shadow-lg shadow-rose-900/20 hover:shadow-rose-900/40 hover:-translate-y-1">
                                                <span class="flex items-center gap-2">
                                                    Book Repair <i class="fas fa-calendar-check group-hover:scale-110 transition-transform"></i>
                                                </span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Right Image Area -->
                                    <div class="hidden md:flex w-1/2 h-full items-center justify-center relative">
                                        <img src="https://images.unsplash.com/photo-1588508065123-287b28e013da?auto=format&fit=crop&q=80&w=800"
                                            class="h-[400px] object-contain drop-shadow-2xl rounded-2xl transform hover:scale-105 transition-transform duration-500 border-4 border-white/10"
                                            alt="Laptop Repair">
                                            
                                        <div class="absolute bottom-20 left-20 bg-gray-900/90 backdrop-blur-md text-white p-4 rounded-2xl shadow-2xl flex items-center gap-4 animate-float-delayed border border-white/10">
                                            <div class="text-center border-r border-gray-700 pr-4">
                                                <p class="text-2xl font-bold text-rose-500">24</p>
                                                <p class="text-[10px] uppercase text-gray-400">Hours</p>
                                            </div>
                                            <div>
                                                <p class="font-bold text-sm">Express</p>
                                                <p class="text-xs text-gray-400">Turnaround</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SLIDE 4: ACCESSORIES -->
                            <div class="min-w-full h-full bg-gradient-to-br from-[#5b21b6] via-[#4c1d95] to-[#2e1065] relative flex items-center overflow-hidden">
                                <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-violet-500/20 rounded-full blur-[100px]"></div>
                                <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-fuchsia-500/20 rounded-full blur-[100px]"></div>

                                <div class="w-full h-full max-w-7xl mx-auto px-6 md:px-16 flex items-center justify-between relative z-10">
                                    <!-- Left Content -->
                                    <div class="w-full md:w-1/2 text-white space-y-8 pl-4">
                                        <h1 class="text-5xl md:text-7xl font-bold leading-tight tracking-tight">
                                            Level Up Your
                                            <br>
                                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-300 to-fuchsia-300">Setup</span>
                                        </h1>
                                        
                                        <p class="text-lg md:text-xl text-violet-200 font-medium max-w-lg leading-relaxed">
                                            Premium mechanical keyboards, high-precision mice, and ergonomic accessories for the ultimate workstation.
                                        </p>
                                        
                                        <div class="flex flex-col sm:flex-row gap-4 pt-2">
                                            <button class="group px-8 py-4 bg-white text-violet-800 font-bold rounded-2xl transition-all duration-300 shadow-lg shadow-violet-900/20 hover:shadow-violet-900/40 hover:-translate-y-1">
                                                <span class="flex items-center gap-2">
                                                    Explore Gear <i class="fas fa-gamepad group-hover:rotate-12 transition-transform"></i>
                                                </span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Right Image Area -->
                                    <div class="hidden md:flex w-1/2 h-full items-center justify-center relative">
                                        <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=800"
                                            class="h-[400px] object-contain drop-shadow-[0_0_40px_rgba(139,92,246,0.3)] rounded-2xl transform rotate-3 hover:rotate-0 transition-transform duration-500"
                                            alt="Gaming Accessories">
                                    </div>
                                </div>
                            </div>

                            <!-- SLIDE 5: STUDENT OFFER -->
                            <div class="min-w-full h-full bg-[#0F172A] relative flex items-center overflow-hidden">
                                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5"></div>
                                <div class="absolute inset-0 bg-gradient-to-r from-blue-900/40 to-transparent"></div>

                                <div class="w-full h-full max-w-7xl mx-auto px-6 md:px-16 flex items-center justify-between relative z-10">
                                    <!-- Left Content -->
                                    <div class="w-full md:w-1/2 text-white space-y-8 pl-4">
                                        <div class="inline-block bg-yellow-400 text-black font-bold px-4 py-1.5 rounded-full text-xs uppercase tracking-wide mb-2 shadow-[0_0_20px_rgba(250,204,21,0.4)] animate-pulse">
                                            Back to School Special
                                        </div>
                                        <h1 class="text-5xl md:text-7xl font-bold leading-tight tracking-tight">
                                            Student
                                            <br>
                                            <span class="text-yellow-400">Discount</span>
                                        </h1>
                                        <p class="text-lg md:text-xl text-gray-300 font-medium max-w-lg leading-relaxed">
                                            Get an extra <span class="text-yellow-400 font-bold">10% OFF</span> on all laptops with a valid student ID. Invest in your future today.
                                        </p>
                                        <div class="flex gap-4 pt-2">
                                            <button class="group px-8 py-4 bg-yellow-400 hover:bg-yellow-300 text-black font-bold rounded-2xl transition-all duration-300 shadow-lg shadow-yellow-500/20 hover:shadow-yellow-500/40 hover:-translate-y-1">
                                                <span class="flex items-center gap-2">
                                                    Claim Offer <i class="fas fa-graduation-cap group-hover:scale-110 transition-transform"></i>
                                                </span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Right Image Area -->
                                    <div class="hidden md:flex w-1/2 h-full items-center justify-center relative">
                                        <div class="relative">
                                            <div class="absolute inset-0 bg-yellow-400 rounded-full blur-[80px] opacity-20 animate-pulse"></div>
                                            <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&q=80&w=800"
                                                class="relative h-[350px] object-contain drop-shadow-2xl rounded-2xl transform hover:-translate-y-2 transition-transform duration-500 border-4 border-white/5"
                                                alt="Student Discounts">
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- Navigation Buttons -->
                        <button class="nav-btn absolute left-4 md:left-8 top-1/2 -translate-y-1/2 bg-white/10 hover:bg-white/20 text-white w-14 h-14 flex items-center justify-center rounded-full backdrop-blur-md border border-white/10 transition-all duration-300 z-30 opacity-0 group-hover:opacity-100 transform -translate-x-4 group-hover:translate-x-0 hover:scale-110"
                            onclick="moveSlide(-1)">
                            <i class="fas fa-chevron-left text-xl"></i>
                        </button>
                        <button class="nav-btn absolute right-4 md:right-8 top-1/2 -translate-y-1/2 bg-white/10 hover:bg-white/20 text-white w-14 h-14 flex items-center justify-center rounded-full backdrop-blur-md border border-white/10 transition-all duration-300 z-30 opacity-0 group-hover:opacity-100 transform translate-x-4 group-hover:translate-x-0 hover:scale-110"
                            onclick="moveSlide(1)">
                            <i class="fas fa-chevron-right text-xl"></i>
                        </button>

                        <!-- Pagination -->
                        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-3 z-30 p-2 rounded-full bg-black/20 backdrop-blur-sm border border-white/5">
                            <button class="dot w-3 h-3 rounded-full bg-white transition-all duration-300 hover:scale-125" onclick="goToSlide(0)"></button>
                            <button class="dot w-3 h-3 rounded-full bg-white/40 hover:bg-white transition-all duration-300 hover:scale-125" onclick="goToSlide(1)"></button>
                            <button class="dot w-3 h-3 rounded-full bg-white/40 hover:bg-white transition-all duration-300 hover:scale-125" onclick="goToSlide(2)"></button>
                            <button class="dot w-3 h-3 rounded-full bg-white/40 hover:bg-white transition-all duration-300 hover:scale-125" onclick="goToSlide(3)"></button>
                            <button class="dot w-3 h-3 rounded-full bg-white/40 hover:bg-white transition-all duration-300 hover:scale-125" onclick="goToSlide(4)"></button>
                        </div>

                    </div>
                </section>
                <!-- HERO SECTION END -->

                <!-- FEATURES BAR START -->
                <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 relative z-20 mb-12">
                    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6 md:p-8">
                        <div
                            class="grid grid-cols-1 md:grid-cols-3 gap-6 divide-y md:divide-y-0 md:divide-x divide-gray-100">

                            <!-- Feature 1 -->
                            <div class="flex items-center justify-center gap-4 px-4">
                                <div
                                    class="w-12 h-12 rounded-full bg-cyan-50 flex items-center justify-center text-cyan-600 shrink-0">
                                    <i class="fas fa-check-circle text-xl"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900 text-sm md:text-base uppercase tracking-wide">
                                        Excellent Condition</h3>
                                    <p class="text-xs md:text-sm text-gray-500 font-medium">Laptops</p>
                                </div>
                            </div>


                            <!-- Feature 2 -->
                            <div class="flex items-center justify-center gap-4 px-4 pt-4 md:pt-0">
                                <div
                                    class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 shrink-0">
                                    <i class="fas fa-rotate text-xl"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900 text-sm md:text-base uppercase tracking-wide">6
                                        Months Warranty</h3>
                                    <p class="text-xs md:text-sm text-gray-500 font-medium">Replacement Guarantee</p>
                                </div>
                            </div>

                            <!-- Feature 3 -->
                            <div class="flex items-center justify-center gap-4 px-4 pt-4 md:pt-0">
                                <div
                                    class="w-12 h-12 rounded-full bg-purple-50 flex items-center justify-center text-purple-600 shrink-0">
                                    <i class="fas fa-screwdriver-wrench text-xl"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900 text-sm md:text-base uppercase tracking-wide">1
                                        Year Warranty</h3>
                                    <p class="text-xs md:text-sm text-gray-500 font-medium">Service Coverage</p>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>
                <!-- FEATURES BAR END -->

                <!-- BRANDS LOGO SECTION START -->
                <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 mb-8">
                    <div class="text-center mb-8">
                        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Brands We Deal In</h2>
                        <div class="w-20 h-1 bg-primary mx-auto mt-2 rounded-full"></div>
                    </div>
                    
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-6 items-center justify-items-center">
                        <!-- Apple -->
                        <a href="/brand/Apple" class="w-full h-24 bg-white rounded-xl shadow-sm border border-gray-100 flex items-center justify-center p-4 hover:shadow-lg hover:-translate-y-2 hover:border-primary/50 hover:bg-primary/5 transition-all duration-300 group cursor-pointer">
                            <img src="/images/apple-logo.png" alt="Apple" class="max-h-12 w-auto object-contain">
                        </a>

                        <!-- Dell -->
                        <a href="/brand/Dell" class="w-full h-24 bg-white rounded-xl shadow-sm border border-gray-100 flex items-center justify-center p-4 hover:shadow-lg hover:-translate-y-2 hover:border-primary/50 hover:bg-primary/5 transition-all duration-300 group cursor-pointer">
                            <img src="/images/dell-logo2.png" alt="Dell" class="max-h-12 w-auto object-contain">
                        </a>

                        <!-- HP -->
                        <a href="/brand/HP" class="w-full h-24 bg-white rounded-xl shadow-sm border border-gray-100 flex items-center justify-center p-4 hover:shadow-lg hover:-translate-y-2 hover:border-primary/50 hover:bg-primary/5 transition-all duration-300 group cursor-pointer">
                            <img src="/images/hp-logo2.png" alt="HP" class="max-h-12 w-auto object-contain">
                        </a>

                        <!-- Lenovo -->
                        <a href="/brand/Lenovo" class="w-full h-24 bg-white rounded-xl shadow-sm border border-gray-100 flex items-center justify-center p-4 hover:shadow-lg hover:-translate-y-2 hover:border-primary/50 hover:bg-primary/5 transition-all duration-300 group cursor-pointer">
                            <img src="/images/lenovo-logo.svg" alt="Lenovo" class="max-h-8 w-auto object-contain">
                        </a>

                        <!-- MSI (Text/Placeholder) -->
                        <a href="/brand/MSI" class="w-full h-24 bg-white rounded-xl shadow-sm border border-gray-100 flex items-center justify-center p-4 hover:shadow-lg hover:-translate-y-2 hover:border-primary/50 hover:bg-primary/5 transition-all duration-300 group cursor-pointer">
                            <img src="/images/MSI-Logo.jpg" alt="MSI" class="max-h-12 w-auto object-contain">
                        </a>
                    </div>
                </section>
                <!-- BRANDS LOGO SECTION END -->

                <!-- OUR SERVICES SECTION START -->
                <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 pt-8">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Explore Categories</h2>
                        <a href="#" class="text-primary font-bold text-sm hover:underline">View All <i
