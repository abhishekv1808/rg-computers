<%- include('../partials/head.ejs') %>

<body class="bg-white font-[Urbanist] text-gray-900 antialiased selection:bg-cyan-100 selection:text-cyan-900">
    <%- include('../partials/navbar.ejs') %>

    <main class="min-h-screen pb-20">
        <!-- Breadcrumb -->
        <div class="max-w-7xl mx-auto px-6 lg:px-12 py-6">
            <nav class="flex text-sm text-gray-500 font-medium">
                <a href="/" class="hover:text-black transition-colors">Home</a>
                <span class="mx-3 text-gray-300">/</span>
                <a href="/laptops" class="hover:text-black transition-colors">Laptops</a>
                <span class="mx-3 text-gray-300">/</span>
                <a href="/brand/<%= laptop.brand %>" class="hover:text-black transition-colors"><%= laptop.brand %></a>
                <span class="mx-3 text-gray-300">/</span>
                <span class="text-black truncate max-w-[200px]"><%= laptop.model %></span>
            </nav>
        </div>

        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 xl:gap-20">
                
                <!-- Left Column: Sticky Image Gallery -->
                <div class="lg:col-span-6">
                    <div class="lg:sticky lg:top-24 space-y-6">
                        <!-- Main Image Stage -->
                        <div class="relative bg-gray-50 rounded-3xl overflow-hidden aspect-[4/3] group border border-gray-100">
                            <!-- Badges -->
                            <div class="absolute top-6 left-6 z-10 flex flex-col gap-3">
                                <div class="bg-black/90 backdrop-blur-md text-white text-xs font-bold px-4 py-2 rounded-full flex items-center gap-2 shadow-xl">
                                    <i class="fas fa-check-circle text-cyan-400"></i>
                                    <span>RG ASSURED</span>
                                </div>
                                <% if (laptop.stockQuantity === 0 || laptop.status === 'Out of Stock') { %>
                                    <div class="bg-red-500 text-white text-xs font-bold px-4 py-2 rounded-full shadow-lg">
                                        Sold Out
                                    </div>
                                <% } %>
                            </div>
                            
                            <!-- Wishlist -->
                            <button class="absolute top-6 right-6 z-10 w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-lg text-gray-400 hover:text-red-500 hover:scale-110 transition-all duration-300">
                                <i class="far fa-heart text-lg"></i>
                            </button>

                            <!-- Main Image -->
                            <div class="absolute inset-0 flex items-center justify-center p-4 lg:p-8">
                                <img id="main-image" src="<%= laptop.imageUrls[0] %>" 
                                     alt="<%= laptop.model %>" 
                                     class="w-full h-full object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-105 filter drop-shadow-xl">
                            </div>
                        </div>

                        <!-- Thumbnails Slider -->
                        <% if(laptop.imageUrls && laptop.imageUrls.length > 1) { %>
                            <div class="relative group/thumbs px-1">
                                <!-- Left Button -->
                                <button onclick="scrollThumbs(-1)" class="absolute -left-3 top-1/2 -translate-y-1/2 z-10 w-8 h-8 rounded-full bg-white shadow-lg border border-gray-100 flex items-center justify-center text-gray-700 hover:bg-black hover:text-white transition-all opacity-0 group-hover/thumbs:opacity-100 disabled:opacity-0 focus:outline-none">
                                    <i class="fas fa-chevron-left text-xs"></i>
                                </button>
                                
                                <div id="thumbnails-container" class="flex gap-4 overflow-x-auto scroll-smooth no-scrollbar py-2 px-1">
                                    <% laptop.imageUrls.forEach((url, index) => { %>
                                        <button onclick="changeImage('<%= url %>', this)" 
                                                class="flex-shrink-0 w-20 h-20 rounded-2xl bg-gray-50 border-2 <%= index === 0 ? 'border-black' : 'border-transparent' %> overflow-hidden hover:border-gray-300 transition-all p-2 group snap-start">
                                            <img src="<%= url %>" class="w-full h-full object-contain mix-blend-multiply group-hover:scale-110 transition-transform duration-300">
                                        </button>
                                    <% }) %>
                                </div>

                                <!-- Right Button -->
                                <button onclick="scrollThumbs(1)" class="absolute -right-3 top-1/2 -translate-y-1/2 z-10 w-8 h-8 rounded-full bg-white shadow-lg border border-gray-100 flex items-center justify-center text-gray-700 hover:bg-black hover:text-white transition-all opacity-0 group-hover/thumbs:opacity-100 focus:outline-none">
                                    <i class="fas fa-chevron-right text-xs"></i>
                                </button>
                            </div>
                        <% } %>

                        <!-- Trust Banners (Desktop) -->
                        <div class="hidden lg:grid grid-cols-3 gap-4 pt-6">
                            <div class="bg-gray-50 rounded-2xl p-4 flex flex-col items-center text-center gap-2 group hover:bg-black hover:text-white transition-colors duration-300">
                                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center shadow-sm text-black group-hover:scale-110 transition-transform">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-sm">32 Points</p>
                                    <p class="text-xs text-gray-500 group-hover:text-gray-400">Quality Check</p>
                                </div>
                            </div>
                            <div class="bg-gray-50 rounded-2xl p-4 flex flex-col items-center text-center gap-2 group hover:bg-black hover:text-white transition-colors duration-300">
                                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center shadow-sm text-black group-hover:scale-110 transition-transform">
                                    <i class="fas fa-exchange-alt"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-sm">15 Days</p>
                                    <p class="text-xs text-gray-500 group-hover:text-gray-400">Easy Replacement</p>
                                </div>
                            </div>
                            <div class="bg-gray-50 rounded-2xl p-4 flex flex-col items-center text-center gap-2 group hover:bg-black hover:text-white transition-colors duration-300">
                                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center shadow-sm text-black group-hover:scale-110 transition-transform">
                                    <i class="fas fa-medal"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-sm">6 Months</p>
                                    <p class="text-xs text-gray-500 group-hover:text-gray-400">Core Warranty</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Details Scroll -->
                <div class="lg:col-span-6 flex flex-col pt-2 lg:pt-4 space-y-10">
                    
                    <!-- Title & Price Header -->
                    <div class="space-y-6">
                        <div>
                            <div class="flex items-center gap-3 mb-3">
                                <span class="bg-cyan-100 text-cyan-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">
                                    <%= laptop.condition || 'Used Laptop' %>
                                </span>
                                <span class="flex items-center gap-1 text-yellow-500 text-sm font-bold">
                                    <i class="fas fa-star"></i> 4.5
                                    <span class="text-gray-400 font-medium ml-1">(12 verified)</span>
                                </span>
                            </div>
                            <h1 class="text-2xl md:text-2xl font-semibold text-gray-900 leading-tight">
                                <%= laptop.model %>
                            </h1>
                            <p class="text-gray-500 font-medium mt-2 text-lg">
                                <%= laptop.specifications.processor %> Edition
                            </p>
                        </div>

                        <div class="p-6 bg-gray-50 rounded-3xl border border-gray-100">
                            <p class="text-red-500 font-bold text-xs uppercase tracking-widest mb-2 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                                Limited Time Deal
                            </p>
                            <div class="flex items-end flex-wrap gap-4">
                                <span class="text-5xl font-black text-gray-900 tracking-tight">
                                    &#8377;<%= laptop.price.toLocaleString('en-IN') %>
                                </span>
                                <div class="flex flex-col mb-1">
                                    <span class="text-lg text-gray-400 line-through font-medium">
                                        &#8377;<%= laptop.mrp.toLocaleString('en-IN') %>
                                    </span>
                                    <span class="text-green-600 font-bold text-sm">
                                        Save &#8377;<%= (laptop.mrp - laptop.price).toLocaleString('en-IN') %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                         <div class="grid grid-cols-2 gap-4">
                            <% if (laptop.stockQuantity === 0 || laptop.status === 'Out of Stock') { %>
                                <button disabled class="col-span-2 bg-gray-200 text-gray-400 rounded-2xl py-5 font-bold text-lg cursor-not-allowed uppercase tracking-wide">
                                    Currently Out of Stock
                                </button>
                            <% } else { %>
                                <form action="/cart" method="POST">
                                    <input type="hidden" name="productId" value="<%= laptop._id %>">
                                    <button type="submit" class="w-full bg-white border-2 border-black text-black rounded-2xl py-4 font-bold text-lg hover:bg-gray-50 transition-all flex items-center justify-center gap-3 group">
                                        <i class="fas fa-shopping-bag group-hover:scale-110 transition-transform"></i>
                                        Add to Cart
                                    </button>
                                </form>
                                <form action="/cart" method="POST"> <!-- Assuming you handle buy now similarly or different route -->
                                    <input type="hidden" name="productId" value="<%= laptop._id %>">
                                    <button type="submit" class="w-full bg-black text-white border-2 border-black rounded-2xl py-4 font-bold text-lg hover:bg-gray-800 hover:border-gray-800 transition-all shadow-xl shadow-gray-200 flex items-center justify-center gap-3 group">
                                        Buy Now
                                        <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="h-px bg-gray-100 w-full"></div>

                    <!-- Visual Specs Grid -->
                    <div>
                        <h3 class="font-bold text-xl text-gray-900 mb-6 flex items-center gap-2">
                            <i class="fas fa-layer-group text-cyan-500"></i>
                            Key Specifications
                        </h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-4 hover:shadow-md transition-shadow">
                                <div class="w-10 h-10 rounded-full bg-cyan-50 flex items-center justify-center text-cyan-600 flex-shrink-0">
                                    <i class="fas fa-microchip"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">Processor</p>
                                    <p class="font-bold text-gray-900 leading-tight"><%= laptop.specifications.processor %></p>
                                </div>
                            </div>
                            <div class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-4 hover:shadow-md transition-shadow">
                                <div class="w-10 h-10 rounded-full bg-cyan-50 flex items-center justify-center text-cyan-600 flex-shrink-0">
                                    <i class="fas fa-memory"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">Memory</p>
                                    <p class="font-bold text-gray-900 leading-tight"><%= laptop.specifications.ram %></p>
                                </div>
                            </div>
                            <div class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-4 hover:shadow-md transition-shadow">
                                <div class="w-10 h-10 rounded-full bg-cyan-50 flex items-center justify-center text-cyan-600 flex-shrink-0">
                                    <i class="fas fa-hdd"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">Storage</p>
                                    <p class="font-bold text-gray-900 leading-tight"><%= laptop.specifications.storage %></p>
                                </div>
                            </div>
                            <div class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-4 hover:shadow-md transition-shadow">
                                <div class="w-10 h-10 rounded-full bg-cyan-50 flex items-center justify-center text-cyan-600 flex-shrink-0">
                                    <i class="fas fa-desktop"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">Display</p>
                                    <p class="font-bold text-gray-900 leading-tight"><%= laptop.specifications.display %></p>
                                </div>
                            </div>
                            <div class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-4 hover:shadow-md transition-shadow">
                                <div class="w-10 h-10 rounded-full bg-cyan-50 flex items-center justify-center text-cyan-600 flex-shrink-0">
                                    <i class="fab fa-windows"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">OS</p>
                                    <p class="font-bold text-gray-900 leading-tight"><%= laptop.specifications.os || 'Windows 10/11' %></p>
                                </div>
                            </div>
                            <% if(laptop.specifications.graphics) { %>
                                <div class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-4 hover:shadow-md transition-shadow">
                                    <div class="w-10 h-10 rounded-full bg-cyan-50 flex items-center justify-center text-cyan-600 flex-shrink-0">
                                        <i class="fas fa-gamepad"></i>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">Graphics</p>
                                        <p class="font-bold text-gray-900 leading-tight"><%= laptop.specifications.graphics %></p>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="h-px bg-gray-100 w-full"></div>

                    <!-- Description -->
                    <div class="prose prose-gray max-w-none">
                        <h3 class="font-bold text-xl text-gray-900 mb-4">About this product</h3>
                        <p class="text-gray-600 leading-relaxed text-base">
                            <%= laptop.description %>
                        </p>
                    </div>

                    <!-- Warranty Add-on -->
                    <div class="bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl p-6 text-white flex items-center justify-between shadow-lg">
                        <div class="flex items-center gap-4">
                             <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center backdrop-blur-sm">
                                <i class="fas fa-shield-virus text-xl"></i>
                             </div>
                             <div>
                                 <h4 class="font-bold text-lg">Extended Warranty</h4>
                                 <p class="text-gray-300 text-sm">Upgrade to 1 Year protection</p>
                             </div>
                        </div>
                        <button class="px-5 py-2.5 bg-white text-black font-bold rounded-xl text-sm hover:bg-gray-100 transition-colors">
                            Add +₹1,499
                        </button>
                    </div>

                </div>
            </div>

                <div class="mt-24 mb-16">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900">Similar Products</h2>
                        <a href="/laptops" class="text-sm font-bold text-gray-500 hover:text-black transition-colors flex items-center gap-2">
                            View All <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                        <% similarLaptops.forEach(item => { 
                            const itemDiscount = item.mrp - item.price;
                        %>
                            <a href="/laptop/<%= item.slug %>" class="group block bg-white rounded-3xl p-3 shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-300">
                                <div class="bg-gray-50 rounded-2xl p-6 mb-4 relative overflow-hidden transition-transform duration-500 group-hover:scale-[1.02]">
                                    <!-- Badges -->
                                    <div class="absolute top-4 left-4 z-10">
                                        <span class="bg-white/90 backdrop-blur-sm text-black text-[10px] font-bold px-3 py-1.5 rounded-full shadow-sm">
                                            <%= item.condition || 'REFURBISHED' %>
                                        </span>
                                    </div>
                                    
                                    <!-- Image -->
                                    <div class="aspect-[4/3] flex items-center justify-center">
                                        <img src="<%= item.imageUrls[0] %>" class="w-full h-full object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-110" alt="<%= item.model %>">
                                    </div>

                                    <!-- Action Button -->
                                    <button class="absolute bottom-4 right-4 w-10 h-10 rounded-full bg-white text-black flex items-center justify-center shadow-md translate-y-12 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 hover:bg-black hover:text-white">
                                        <i class="fas fa-arrow-right"></i>
                                    </button>
                                </div>

                                <div class="px-2">
                                    <h3 class="font-bold text-gray-900 mb-1 leading-tight group-hover:text-cyan-700 transition-colors line-clamp-2 h-10">
                                        <%= item.model %>
                                    </h3>
                                    <p class="text-sm text-gray-400 mb-3 truncate">
                                        <%= item.specifications.processor %> / <%= item.specifications.ram %> / <%= item.specifications.storage %>
                                    </p>
                                    
                                    <div class="flex items-baseline gap-3">
                                        <span class="text-lg font-bold text-gray-900">₹<%= item.price.toLocaleString('en-IN') %></span>
                                        <span class="text-xs text-gray-400 line-through">₹<%= item.mrp.toLocaleString('en-IN') %></span>
                                        <span class="text-xs font-bold text-green-600">Save ₹<%= itemDiscount.toLocaleString('en-IN') %></span>
                                    </div>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                </div>

        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        function scrollThumbs(direction) {
            const container = document.getElementById('thumbnails-container');
            const scrollAmount = 150; 
            container.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
        }

        function changeImage(url, element) {
            // Update main image source
            const mainImg = document.getElementById('main-image');
            mainImg.style.opacity = '0'; // smooth transition effect
            
            setTimeout(() => {
                mainImg.src = url;
                mainImg.style.opacity = '1';
            }, 100);

            // Update sticky border for active state (remove from all, add to clicked)
            const parentDiv = element.parentElement;
            const buttons = parentDiv.querySelectorAll('button');
            buttons.forEach(btn => {
                btn.classList.remove('border-black');
                btn.classList.add('border-transparent');
            });
            
            element.classList.remove('border-transparent');
            element.classList.add('border-black');
        }
    </script>
</body>